# Authentication is read only by the OpenAI reference adapter.
OPENAI_API_KEY=

# Lock these rates before each benchmark run. Do not infer current prices from
# this template; record a dated URL or immutable price-card digest as source.
ATLASBENCH_OPENAI_INPUT_USD_PER_1M=
ATLASBENCH_OPENAI_CACHED_INPUT_USD_PER_1M=
ATLASBENCH_OPENAI_OUTPUT_USD_PER_1M=
ATLASBENCH_OPENAI_PRICING_SOURCE=

# Optional; defaults to 110000 and must remain below the outer adapter timeout.
ATLASBENCH_OPENAI_TIMEOUT_MS=110000
