{
  "name": "atlaspec",
  "version": "0.2.0-rc.1",
  "description": "Intent-first map specifications for reliable AI-generated cartography",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "ai-agents",
    "cartography",
    "maplibre",
    "semantic-ir",
    "vega-lite"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tauptlab/atlaspec.git"
  },
  "bugs": {
    "url": "https://github.com/tauptlab/atlaspec/issues"
  },
  "homepage": "https://github.com/tauptlab/atlaspec#readme",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "atlaspec": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "adapter:claude-cli": "tsx benchmark/providers/claude-cli-stdio.ts",
    "adapter:codex-cli": "tsx benchmark/providers/codex-cli-stdio.ts",
    "adapter:openai": "tsx benchmark/providers/openai-stdio.ts",
    "atlaspec": "tsx src/cli.ts",
    "atlasbench": "tsx benchmark/compare.ts",
    "benchmark:smoke": "tsx benchmark/run.ts --manifest benchmark/pilot.manifest.json --json",
    "benchmark:v02:dry-run": "tsx benchmark/v02/dry-run.ts",
    "benchmark:v02:render:calibrate": "tsx benchmark/v02/render-calibration-cli.ts",
    "benchmark:v02:render": "tsx benchmark/v02/render-evidence-cli.ts",
    "benchmark:v02:run": "tsx benchmark/v02/run-cli.ts",
    "benchmark:v02:rnd:reference-layout": "tsx benchmark/v02/rnd/run-reference-layout-cli.ts",
    "benchmark:v02:rnd:occlusion-ablation": "tsx benchmark/v02/rnd/run-occlusion-ablation-cli.ts",
    "benchmark:v02:rnd:analyze-repair": "tsx benchmark/v02/rnd/analyze-symmetric-repair-cli.ts",
    "benchmark:v02:local:prepare": "tsx benchmark/v02/local/prepare-cli.ts",
    "benchmark:v02:local:run-job": "tsx benchmark/v02/local/run-job-cli.ts",
    "benchmark:v02:local:status": "tsx benchmark/v02/local/status-cli.ts",
    "benchmark:official:prepare": "tsx benchmark/official/prepare-cli.ts",
    "benchmark:official:run-job": "tsx benchmark/official/run-job-cli.ts",
    "benchmark:official:status": "tsx benchmark/official/status-cli.ts",
    "benchmark:local:prepare": "tsx benchmark/local/prepare-cli.ts",
    "benchmark:local:closure": "tsx benchmark/local/closure-cli.ts",
    "benchmark:local:run-job": "tsx benchmark/local/run-job-cli.ts",
    "benchmark:local:status": "tsx benchmark/local/status-cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm test && npm run corpus:check && npm run corpus:v02:check && npm run reference:atlaspec:check",
    "corpus:check": "tsx benchmark/corpus/generate.ts --check",
    "corpus:generate": "tsx benchmark/corpus/generate.ts",
    "corpus:v02:check": "tsx benchmark/v02/generate.ts --check",
    "corpus:v02:generate": "tsx benchmark/v02/generate.ts",
    "corpus:prepare": "tsx benchmark/corpus/prepare-cli.ts",
    "demo:generate": "tsx demo/generate.ts",
    "demo:generate:check": "tsx demo/generate.ts --check",
    "demo:test": "npm run demo:generate:check && node --test demo/demo.test.js experiments/spatial-analysis/engine.test.js",
    "prepack": "npm run build",
    "reference:atlaspec:check": "tsx benchmark/references/generate-atlaspec.ts --check",
    "reference:atlaspec:generate": "tsx benchmark/references/generate-atlaspec.ts",
    "release:verify": "npm run check && npm run build && npm run benchmark:v02:dry-run && npm pack --dry-run",
    "test": "vitest run src benchmark && npm run demo:test",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.52",
    "ajv": "8.20.0",
    "commander": "14.0.2",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-style-spec": "24.0.0",
    "@types/node": "24.10.1",
    "maplibre-gl": "^5.24.0",
    "playwright-core": "^1.61.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vega": "^6.2.0",
    "vega-lite": "^6.4.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@mapbox/jsonlint-lines-primitives": "2.0.2"
  }
}
